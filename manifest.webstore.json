{
  "manifest_version": 3,
  "name": "FillGST Helper",
  "version": "0.9.4",
  "description": "Connects FillGST to the GST portal + your local TallyPrime — no OTP after first login, books data never leaves your PC.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FillGST Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://services.gst.gov.in/*",
        "https://return.gst.gov.in/*",
        "https://gstr2b.gst.gov.in/*",
        "https://returns.gst.gov.in/*",
        "https://einvoice.gst.gov.in/*"
      ],
      "js": ["src/content/portal-helper.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fillgst.com/*",
        "https://*.fillgst.com/*",
        "https://fillgst.in/*",
        "https://*.fillgst.in/*",
        "https://fillgst.ai/*",
        "https://*.fillgst.ai/*"
      ],
      "js": ["src/content/fillgst-marker.ts"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fillgst.com/*",
        "https://*.fillgst.com/*",
        "https://fillgst.in/*",
        "https://*.fillgst.in/*",
        "https://fillgst.ai/*",
        "https://*.fillgst.ai/*"
      ],
      "js": ["src/content/tally-inject.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fillgst.com/*",
        "https://*.fillgst.com/*",
        "https://fillgst.in/*",
        "https://*.fillgst.in/*",
        "https://fillgst.ai/*",
        "https://*.fillgst.ai/*"
      ],
      "js": ["src/content/tally-relay.ts"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["cookies", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.gst.gov.in/*",
    "http://localhost:9000/*",
    "http://127.0.0.1:9000/*",
    "http://localhost:9876/*",
    "http://127.0.0.1:9876/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fillgst.com/*",
      "https://*.fillgst.com/*",
      "https://fillgst.in/*",
      "https://*.fillgst.in/*",
      "https://fillgst.ai/*",
      "https://*.fillgst.ai/*"
    ]
  }
}
