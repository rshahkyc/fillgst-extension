{
  "manifest_version": 3,
  "name": "FillGST Helper",
  "version": "0.7.0",
  "description": "Connects FillGST to the GST portal + your local TallyPrime — no OTP after first login, no automation fingerprint, books data never leaves your PC.",
  "minimum_chrome_version": "111",
  "update_url": "https://fillgst.com/api/extension/updates.xml",
  "key": "",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FillGST Helper"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://services.gst.gov.in/*",
        "https://return.gst.gov.in/*",
        "https://gstr2b.gst.gov.in/*",
        "https://returns.gst.gov.in/*",
        "https://einvoice.gst.gov.in/*"
      ],
      "js": ["src/content/portal-helper.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fillgst.com/*",
        "https://*.fillgst.com/*",
        "https://fillgst.in/*",
        "https://*.fillgst.in/*",
        "https://fillgst.ai/*",
        "https://*.fillgst.ai/*",
        "https://fillgst.vercel.app/*",
        "https://*.vercel.app/*",
        "https://*.run.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["src/content/fillgst-marker.ts"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fillgst.com/*",
        "https://*.fillgst.com/*",
        "https://fillgst.in/*",
        "https://*.fillgst.in/*",
        "https://fillgst.ai/*",
        "https://*.fillgst.ai/*",
        "https://fillgst.vercel.app/*",
        "https://*.vercel.app/*",
        "https://*.run.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["src/content/tally-inject.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fillgst.com/*",
        "https://*.fillgst.com/*",
        "https://fillgst.in/*",
        "https://*.fillgst.in/*",
        "https://fillgst.ai/*",
        "https://*.fillgst.ai/*",
        "https://fillgst.vercel.app/*",
        "https://*.vercel.app/*",
        "https://*.run.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["src/content/tally-relay.ts"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["cookies", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.gst.gov.in/*",
    "http://localhost:9000/*",
    "http://127.0.0.1:9000/*",
    "http://localhost:9876/*",
    "http://127.0.0.1:9876/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fillgst.com/*",
      "https://*.fillgst.com/*",
      "https://fillgst.in/*",
      "https://*.fillgst.in/*",
      "https://fillgst.ai/*",
      "https://*.fillgst.ai/*",
      "https://fillgst.vercel.app/*",
      "https://*.vercel.app/*",
      "https://*.run.app/*",
      "http://localhost/*",
      "http://localhost:*/*",
      "http://127.0.0.1/*",
      "http://127.0.0.1:*/*"
    ]
  }
}
